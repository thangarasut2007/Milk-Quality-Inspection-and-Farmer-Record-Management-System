from abc import ABC, abstractmethod

class Milk(ABC):

    @abstractmethod
    def registerFarmer(self):
        pass

    @abstractmethod
    def collectMilk(self):
        pass

    @abstractmethod
    def checkQuality(self, temperature, ph, conductivity):
        pass

    @abstractmethod
    def calculateAmount(self, litre, quality):
        pass

    @abstractmethod
    def checkAmount(self):
        pass

    @abstractmethod
    def searchFarmer(self):
        pass

    @abstractmethod
    def updateDetails(self):
        pass

    @abstractmethod
    def deleteFarmer(self):
        pass

    @abstractmethod
    def viewAllFarmers(self):
        pass

    @abstractmethod
    def transactionHistory(self):
        pass

    @abstractmethod
    def dailyReport(self):
        pass

    @abstractmethod
    def alertNotification(self, quality):
        pass

class Farmer:

