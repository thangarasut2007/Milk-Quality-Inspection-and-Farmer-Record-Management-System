            print("pH             :", farmer.get_ph())
            print("Conductivity   :", farmer.get_conductivity())
            print("Quality        :", farmer.get_quality())
            print("Amount         : ₹", farmer.get_amount())
            print("Date & Time    :", farmer.get_date())
            return

    print("Farmer Not Found")


