def viewAllFarmers(self):

    if len(self.farmers) == 0:

        print("No Farmers Available")
        return

    print("\n========== ALL FARMERS ==========")

    for farmer in self.farmers:

        print("--------------------------------------")
        print("Farmer ID      :", farmer.get_farmer_id())
        print("Name           :", farmer.get_name())
        print("Mobile         :", farmer.get_mobile())
        print("Milk Quantity  :", farmer.get_milk(), "L")
        print("Quality        :", farmer.get_quality())
        print("Amount         : ₹", farmer.get_amount())


# ==========================
# Transaction History
# ==========================

def transactionHistory(self):

    name = input("Enter Farmer Name : ")

    for farmer in self.farmers:

        if farmer.get_name() == name:

            print("\n========== TRANSACTION HISTORY ==========")

            history = farmer.get_history()

            if len(history) == 0:
                print("No Transactions Found")

            else:

                for i, transaction in enumerate(history, 1):

                    print(i, ".", transaction)

            return

    print("Farmer Not Found")


# ==========================
# Daily Collection Report
# ==========================

def dailyReport(self):

    total_farmers = len(self.farmers)

    total_milk = 0
    total_amount = 0

    for farmer in self.farmers:

        total_milk += farmer.get_milk()
        total_amount += farmer.get_amount()

    print("\n========== DAILY REPORT ==========")
    print("Total Farmers     :", total_farmers)
    print("Total Milk        :", total_milk, "L")
    print("Total Amount      : ₹", total_amount)


