def deleteFarmer(self):

    name = input("Enter Farmer Name : ")

    for farmer in self.farmers:

        if farmer.get_name() == name:

            self.farmers.remove(farmer)

            print("Farmer Deleted Successfully")
            return

    print("Farmer Not Found")


