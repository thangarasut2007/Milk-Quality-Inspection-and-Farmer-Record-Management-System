def updateDetails(self):

    name = input("Enter Farmer Name : ")

    for farmer in self.farmers:

        if farmer.get_name() == name:

            print("\n1. Update Name")
            print("2. Update Mobile")

            choice = int(input("Enter Choice : "))

            if choice == 1:

                new_name = input("Enter New Name : ")
                farmer.set_name(new_name)
                farmer.add_history("Farmer Name Updated")

            elif choice == 2:

                new_mobile = input("Enter New Mobile Number : ")
                farmer.set_mobile(new_mobile)
                farmer.add_history("Mobile Number Updated")

            else:
                print("Invalid Choice")
                return

            print("Details Updated Successfully")
            return

    print("Farmer Not Found")
