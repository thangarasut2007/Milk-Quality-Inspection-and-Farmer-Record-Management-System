        self.__name = name
        self.__mobile = mobile
        self.__milk = 0.0
        self.__temperature = 0.0
        self.__ph = 0.0
        self.__conductivity = 0.0
        self.__quality = "Not Checked"
        self.__amount = 0.0
        self.__date = ""
        self.__history=[]
