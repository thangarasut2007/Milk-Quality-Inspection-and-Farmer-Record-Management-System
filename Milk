def searchFarmer(self):

    name = input("Enter Farmer Name : ")

    for farmer in self.farmers:

        if farmer.get_name() == name:

            print("\n========== FARMER DETAILS ==========")
            print("Farmer ID      :", farmer.get_farmer_id())
            print("Name           :", farmer.get_name())
            print("Mobile         :", farmer.get_mobile())
            print("Milk           :", farmer.get_milk(), "L")
